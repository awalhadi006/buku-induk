{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "buku-induk",
	"compatibility_date": "2026-08-11",
	"compatibility_flags": [
		"nodejs_als"
	],
	"pages_build_output_dir": ".svelte-kit/cloudflare",
	"kv_namespaces": [
		{ "binding": "GDRIVE_TOKENS", "id": "<your-kv-namespace-id>" }
	]
}
