# === VARIABEL LINGKUNGAN PUBLIK (di-bake di build time, safe untuk client bundle) ===
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=

# === VARIABEL LINGKUNGAN PRIVAT (hanya runtime Workers Cloudflare Pages, DIWajibkan di Production environment variables) ===
# Jangan masukkan secrets ini ke client bundle; gunakan $env/dynamic/private di SvelteKit
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# === PENGATURAN OPSIONAL DI LUAR SIGN IN ===
# PUBLIC_CSP_REPORT_ONLY=false (false = CSP enforcing; true = CSP report-only (hanya aktif jika middleware Workers di-deploy))
